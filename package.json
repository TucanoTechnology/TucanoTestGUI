{
  "name": "tucano-test-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessible web GUI for the Tucano Test API",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:client": "node scripts/generate-client.mjs",
    "sync:openapi": "node scripts/sync-openapi.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "openapi-typescript-codegen": "^0.31.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
